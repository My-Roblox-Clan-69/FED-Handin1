<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarWorkshopApp.Views.HomePage"
             Title="Home"
             BackgroundColor="White">

    <Grid Padding="40" RowDefinitions="Auto, *, Auto">
        
        <!-- Header Text -->
        <Label Text="Welcome to ServiceHub"
               FontSize="32"
               FontAttributes="Bold"
               TextColor="Black"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0,30,0,20"/>

        <!-- Buttons Section -->
        <VerticalStackLayout Grid.Row="1" Spacing="20"
                             HorizontalOptions="Center"
                             WidthRequest="300">

            <Button Text="Book a Service"
                    Clicked="GoToBookingPage"
                    BackgroundColor="{StaticResource SexyBlue}"
                    TextColor="White"
                    CornerRadius="20"
                    FontSize="20"
                    HeightRequest="55"
                    WidthRequest="250"/>

            <Button Text="Service Overview"
                    Clicked="GoToOverviewPage"
                    BackgroundColor="{StaticResource SexyBlue}"
                    TextColor="White"
                    CornerRadius="20"
                    FontSize="20"
                    HeightRequest="55"
                    WidthRequest="250"/>
                    
            <Button Text="Invoice"
                    Clicked="GoToInvoicePage"
                    BackgroundColor="{StaticResource SexyGreen}"
                    TextColor="White"
                    CornerRadius="20"
                    FontSize="20"
                    HeightRequest="55"
                    WidthRequest="250"/>
            
        </VerticalStackLayout>
    </Grid>
</ContentPage>
