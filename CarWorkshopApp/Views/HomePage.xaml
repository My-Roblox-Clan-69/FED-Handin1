<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CarWorkshopApp.Views.HomePage"
             Title="Home">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="Welcome to Car Workshop"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"/>

        <Image Source="car_service.png"
               HeightRequest="200"
               Aspect="AspectFit"
               HorizontalOptions="Center"/>

        <Button Text="Book a Service"
                Clicked="GoToBookingPage"
                BackgroundColor="CornflowerBlue"
                TextColor="White"
                CornerRadius="10"/>

        <Button Text="View Services"
                Clicked="GoToServicesPage"
                BackgroundColor="DarkSlateBlue"
                TextColor="White"
                CornerRadius="10"/>

        <Button Text="About Us"
                Clicked="GoToAboutPage"
                BackgroundColor="DarkGray"
                TextColor="White"
                CornerRadius="10"/>

    </VerticalStackLayout>
</ContentPage>
