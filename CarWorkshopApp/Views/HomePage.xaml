<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarWorkshopApp.Views.HomePage"
             Title="Home"
             BackgroundColor="#f8f9fa">

    <VerticalStackLayout Padding="30" Spacing="20">

        <Label Text="Welcome to Car Workshop"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="Black"
               HorizontalOptions="Center"/>

        <Button Text="Book a Service"
                Clicked="GoToBookingPage"
                BackgroundColor="#4A90E2"
                TextColor="White"
                CornerRadius="12"
                FontSize="18"
                HeightRequest="50"/>
        <Button 
                Text="Overview"
                Clicked="GoToOverviewPage"
                BackgroundColor="#FFA500"
                TextColor="White"
                CornerRadius="12"
                FontSize="18"
                HeightRequest="50"/>


    </VerticalStackLayout>
</ContentPage>
