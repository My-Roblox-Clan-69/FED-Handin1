<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarWorkshopApp.Views.ServicesPage"
             Title="Services">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Available Services"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center"/>

        <CollectionView ItemsSource="{Binding Services}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" CornerRadius="10" BackgroundColor="White">
                        <HorizontalStackLayout Spacing="10">
                            <Image Source="{Binding Icon}" WidthRequest="40" HeightRequest="40"/>
                            <Label Text="{Binding Name}" FontSize="18"/>
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
