<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarWorkshopApp.Views.OverviewPage"
             Title="Bookings Overview">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Select Date to View Bookings" 
               FontSize="20"
               FontAttributes="Bold"/>

        <DatePicker x:Name="datePicker"
                    Date="{Binding SelectedDate, Mode=TwoWay}"
                    MinimumDate="{Binding MinDate}"
                    MaximumDate="{Binding MaxDate}"/>

        <ListView ItemsSource="{Binding BookingsForSelectedDate}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame Padding="10" BorderColor="Gray">
                            <StackLayout>
                                <Label Text="{Binding CustomerName}" 
                                       FontSize="18"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding CarBrand}" FontSize="16"/>
                                <Label Text="{Binding ServiceDescription}" FontSize="14"/>
                                <Label Text="{Binding SelectedDate, StringFormat='{0:MMMM dd, yyyy HH:mm}'}" FontSize="14"/>
                            </StackLayout>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </VerticalStackLayout>
</ContentPage>
