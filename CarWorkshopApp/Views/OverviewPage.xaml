<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarWorkshopApp.Views.OverviewPage"
             Title="Bookings Overview">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Select Date to View Bookings" 
               FontSize="20"
               FontAttributes="Bold"/>

        <DatePicker x:Name="datePicker"
                    Date="{Binding SelectedDate, Mode=TwoWay}"
                    MinimumDate="{Binding MinDate}"
                    MaximumDate="{Binding MaxDate}"/>

        <ListView ItemsSource="{Binding BookingsForSelectedDate}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame Padding="10" BorderColor="Gray" CornerRadius="8" Margin="5">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding CustomerName}" 
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="Black"/>

                                <Label Text="{Binding CustomerAddress, StringFormat='🏠 Address: {0}'}"
                                       FontSize="14" 
                                       TextColor="DarkGray"/>

                                <Label Text="{Binding CarBrand, StringFormat='🚗 Brand: {0}'}"
                                       FontSize="16"
                                       TextColor="Black"/>

                                <Label Text="{Binding CarModel, StringFormat='📌 Model: {0}'}"
                                       FontSize="14"
                                       TextColor="DarkGray"/>

                                <Label Text="{Binding CarRegistration, StringFormat='🔢 Reg: {0}'}"
                                       FontSize="14"
                                       TextColor="DarkGray"/>

                                <Label Text="{Binding ServiceDescription, StringFormat='🛠 Task: {0}'}"
                                       FontSize="14"
                                       TextColor="DarkGray"/>

                                <Label Text="{Binding SelectedDate, StringFormat='📅 Date: {0:MMMM dd, yyyy HH:mm}'}"
                                       FontSize="14"
                                       TextColor="Black"/>
                            </VerticalStackLayout>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </VerticalStackLayout>
</ContentPage>
