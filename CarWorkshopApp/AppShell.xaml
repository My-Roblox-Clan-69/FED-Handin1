<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CarWorkshopApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CarWorkshopApp.Views;assembly=CarWorkshopApp"
    Shell.FlyoutBehavior="Flyout"
    Title="Car Workshop App">

    <!-- Home Page -->
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage"
        Icon="home_icon.png" />

    <!-- Booking Page -->
    <ShellContent
        Title="Book a Service"
        ContentTemplate="{DataTemplate views:BookingPage}"
        Route="BookingPage"
        Icon="booking_icon.png" />

    <ShellContent 
        Title="Overview"
        ContentTemplate="{DataTemplate views:OverviewPage}"
        Route="OverviewPage"
        Icon="calendar_icon.png"/>


</Shell>
